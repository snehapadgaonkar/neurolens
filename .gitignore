# NeuroLens generated artifacts.
# Real datasets are fetched into the top-level `data/` directory by
# `neurolens fetch-data`; run artifacts are written by `neurolens run`.
# Neither belongs in version control. The patterns are anchored to the repo
# root so that the real test fixtures under `tests/data/` stay tracked.
/data/
/runs/
/artifacts/
*.joblib

# Notebook checkpoints and Colab scratch space.
.ipynb_checkpoints/
scratch/

# OS / editor
.DS_Store
.idea/
.vscode/

# Node / Next.js
node_modules/
.next/
out/
.next-swc/
*.tsbuildinfo
next-env.d.ts

# Bundles generated by `npm run check:render` / `check:shell`
web/scripts/render-check/bundle.cjs
web/scripts/render-check/_shell.cjs
web/scripts/render-check/_shell-entry.tsx
web/scripts/render-check/nav-shim.js
web/scripts/render-check/link-shim.js


